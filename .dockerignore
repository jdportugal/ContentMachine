.git
.github
.gitattributes

# Never leak host deps into the build (Remotion's node_modules is built INSIDE
# the image; **/node_modules also keeps the root Vite deps out of the final layer).
**/node_modules
vendor
public/build
public/hot

# Secrets + local state
.env
.env.*
!.env.example
storage/*.key
storage/app/app_key
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
database/database.sqlite
/contentmachine
*.sqlite
*.sqlite3

# Runtime content (lives on a volume, not baked in) — except the themes, which
# the image carries as a seed (Dockerfile copies them to /app/vault-seed; the
# entrypoint syncs them into the vault volume at boot).
vault/*
!vault/themes
vaults

# Dev-only
tests
.playwright-mcp
deploy
*.md
!Brand-Machine-design-system.md
install.sh
