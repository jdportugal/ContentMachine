APP_NAME="Maquina de Conteudo"
APP_ENV=local
APP_KEY=
# SECURITY: keep APP_DEBUG=false. With debug on, any unhandled error renders the
# Ignition/Whoops page, which LISTS EVERY ENVIRONMENT VARIABLE — API keys
# included — to whoever hit the app. Turn it on only for local development, never
# on an instance reachable over the network.
APP_DEBUG=false
APP_URL=http://localhost:8080
# Porta exposta pelo Nginx (docker compose)
APP_PORT=8080

# SECURITY: the app requires a signed-in user for every page and media route —
# it holds your API keys and every generated asset. On a fresh install the deploy
# seeds a single admin account (see `php artisan app:ensure-admin`) and leaves the
# generated password in storage/app/admin_password. Set these to choose your own
# instead; then no password is ever written to disk.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SECURITY: sign-up is OPEN by default, so anyone who reaches /register can
# create an account — and an account can read every API key above. Once your own
# account exists, set REGISTRATION_OPEN=false. Sign-up then stays possible for
# the first account on a fresh install, and for anyone you give the code to.
REGISTRATION_OPEN=true
REGISTRATION_CODE=

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de dados ----
# Local (sem Docker): sqlite. Com Docker: pgsql (ver docker-compose.yml).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=contentmachine
DB_USERNAME=contentmachine
DB_PASSWORD=secret

# ---- Sessão / cache / filas ----
# Local: database/sync. Docker: redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ateca@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# ContentMachine — o "cérebro" e as integrações
# ============================================================

# Vault Obsidian (pasta de ficheiros .md). Em Docker é um volume montado.
VAULT_PATH=/var/www/html/vault

# Drivers: 'fake' (predefinido, sem chaves) ou 'api' (requer credenciais).
MONITORING_DRIVER=fake
NEWS_DRIVER=fake
# Clips Animados: 'fake' (sem chaves) ou 'api' (OpenAI + ElevenLabs + Remotion).
CLIPS_DRIVER=fake

# ---- Agregador (yt-dlp, metadados-only) ----
# Comando base do yt-dlp. Docker: 'yt-dlp'. Local via pip --user: 'python3 -m yt_dlp'.
YTDLP_CMD=yt-dlp
AGGREGATION_LIMIT=5
AGGREGATION_TIMEOUT=120

# ---- Chaves de API (todas VAZIAS por defeito) ----
# Preencha apenas quando mudar os drivers para 'api'.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com
TUBELAB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- LLM para a redação/tópicos do agregador ----
# 'claude-cli' usa o CLI do Claude Code (reutiliza a tua sessão, SEM chave de API).
# 'auto' prefere o CLI se existir, senão OpenAI/Gemini. 'none' desliga (heurística).
LLM_PROVIDER=auto
# Deixa o Claude usar pesquisa/leitura web para ir buscar contexto às fontes (mais lento). false desliga.
# CLAUDE_CLI_WEB=true
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_MODEL=

# Publicações — desenho dos cartões: 'svg' (offline) ou 'kie' (requer chave kie.ai)
PUBLICACOES_RENDER=kie
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_IMAGE_MODEL=nano-banana-2
KIE_TEXT_IMAGE_MODEL=nano-banana-pro

# Blotato — publicação/agendamento nas redes sociais (opcional; também editável em Definições)
BLOTATO_API_KEY=

# ---- Gerador de Clips (motor LOCAL: ffmpeg + Whisper, sem API externa) ----
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Python com faster-whisper (ou openai-whisper) instalado. Ex.: caminho de um venv.
WHISPER_PYTHON=python3
# Modelo Whisper: tiny (rápido) | base | small | medium
WHISPER_MODEL=tiny

# ---- Clips Animados ----
# Planeador de animações: 'claude' (usa a subscrição via CLI `claude`, sem custo
# por token) ou 'openai' (API paga). Transcrição usa sempre Whisper (OpenAI).
CLIPS_PLANNER=claude
# CLIPS_CLAUDE_BINARY=claude
ELEVENLABS_API_KEY=
# Voz por defeito (ElevenLabs). EXAVITQu4vr4xnSDxMaL = "Sarah" (multilingue).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Modelo de planeamento e dimensões de saída (opcional).
CLIPS_OPENAI_MODEL=gpt-4o
CLIPS_WIDTH=1080
CLIPS_HEIGHT=1920
CLIPS_FPS=30
