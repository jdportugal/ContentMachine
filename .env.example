APP_NAME="Maquina de Conteudo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Porta exposta pelo Nginx (docker compose)
APP_PORT=8080

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de dados ----
# Local (sem Docker): sqlite. Com Docker: pgsql (ver docker-compose.yml).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=contentmachine
DB_USERNAME=contentmachine
DB_PASSWORD=secret

# ---- Sessão / cache / filas ----
# Local: database/sync. Docker: redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ateca@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# ContentMachine — o "cérebro" e as integrações
# ============================================================

# Vault Obsidian (pasta de ficheiros .md). Em Docker é um volume montado.
VAULT_PATH=/var/www/html/vault

# Drivers: 'fake' (predefinido, sem chaves) ou 'api' (requer credenciais).
MONITORING_DRIVER=fake
NEWS_DRIVER=fake

# ---- Chaves de API (todas VAZIAS por defeito) ----
# Preencha apenas quando mudar os drivers para 'api'.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com
TUBELAB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Gerador de Clips (ShortsCreator, API Flask externa) ----
# URL base da API. Também configurável em Definições (guardado no vault).
SHORTS_API_URL=http://localhost:5000
