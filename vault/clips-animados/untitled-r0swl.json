        "research": {
            "topic": "Agentic search is eating agent token budgets - and RL-trained search sub-agents are the fix",
            "summary": "Coding and research agents burn most of their context budget on retrieval, and frontier-model agentic search is accurate but slow and expensive. In 2025-2026 several labs (Cognition, SID.ai, Chroma) shipped small RL-trained search sub-agents that match or beat frontier models at retrieval while being far faster and cheaper.",
            "timeline": [
                {
                    "label": "Survey maps RL-based agentic search as a field",
                    "sublabel": "Oct 2025 (arXiv 2510.16724)"
                },
                {
                    "label": "Cognition ships SWE-grep / SWE-grep-mini + Fast Context sub-agent",
                    "sublabel": "Oct 2025"
                },
                {
                    "label": "SID.ai releases SID-1, RL-trained end-to-end for agentic retrieval (Qwen3-14B base)",
                    "sublabel": "Dec 2025"
                },
                {
                    "label": "Chroma releases Context-1, 20B open-weights search agent (Apache 2.0)",
                    "sublabel": "Mar 2026"
                },
                {
                    "label": "Max Rumpf (SID.ai) talk: search is having its 'Bitter Lesson' moment",
                    "sublabel": "2026, AI Engineer World's Fair"
                }
            ],
            "stats": [
                {
                    "label": "SID-1 recall on SID's hard retrieval benchmark (vendor-reported, Dec 2025)",
                    "value": 0.84,
                    "unit": "recall"
                },
                {
                    "label": "GPT-5.1 recall on same benchmark",
                    "value": 0.78,
                    "unit": "recall"
                },
