                },
                {
                    "label": "First CL1 units ship to researchers",
                    "sublabel": "Mid 2025"
                },
                {
                    "label": "20-unit biological server rack live at NUS, Singapore",
                    "sublabel": "Aug 17, 2026"
                },
                {
                    "label": "Planned ~1,000-unit Bio Data Centre",
