      "comparisons": [
        {
          "title": "By hand vs automated studio pipeline",
          "left": {
            "title": "Manual, clip by clip",
            "points": [
              "You pay per second on each model page yourself",
              "Retries dominate the bill: budget 3-5 attempts per usable shot",
              "Typical selection rate around 25% of generated clips",
              "Full control, much slower turnaround"
            ]
          },
          "right": {
            "title": "Studio / agentic pipeline",
            "points": [
              "Same models, one unified credit or billing layer",
              "Documented AI productions: roughly $315-$750 per finished minute, all-in",
              "3-minute animated episode: ~$950 total, 2-person team, 2 days",
              "Multi-model routing avoids single-vendor risk (see Sora shutdown)"
            ]
          }
        },
        {
          "title": "AI generation vs traditional production",
          "left": {
            "title": "AI video",
            "points": [
              "Cents per second on entry tiers; a few dollars per finished minute of raw generation",
              "Same-day delivery, often under a few hours",
              "Cheapest tiers start at $0.05 per second with native audio"
