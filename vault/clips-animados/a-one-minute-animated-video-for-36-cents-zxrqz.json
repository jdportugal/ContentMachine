          },
          "right": {
            "title": "Traditional animation / shoot",
            "points": [
              "Roughly $3,000 per minute for simple motion graphics, up to $50,000+ for high-end 3D",
              "5 to 10 weeks from kickoff to final file",
              "A 2-minute brand film was estimated at $100,000-$500,000 traditionally"
            ]
          }
        }
