        "research": {
            "topic": "Anthropic adds invisible watermarks to Claude's AI-generated text",
            "summary": "In August 2026 Anthropic announced that Claude models will embed an invisible statistical watermark in generated text plus signed provenance metadata in files, to comply with the EU AI Act's Article 50 transparency rules — applied globally, not just in the EU.",
            "timeline": [
                {
                    "label": "Google DeepMind publishes SynthID Text, the method Claude's watermark builds on",
                    "sublabel": "2024"
                },
                {
                    "label": "EU Commission adopts guidelines on AI transparency obligations",
                    "sublabel": "Jul 20, 2026"
                },
                {
                    "label": "EU AI Act Article 50 transparency rules become applicable",
                    "sublabel": "Aug 2, 2026"
                },
                {
                    "label": "Anthropic announces Claude text watermarking",
                    "sublabel": "Aug 11, 2026"
                },
                {
                    "label": "Deadline for pre-existing generative AI systems to meet machine-readable marking rule",
                    "sublabel": "Dec 2, 2026"
                }
            ],
            "stats": [
                {
                    "label": "Max EU fine for Article 50 non-compliance",
                    "value": 15,
                    "unit": "million €"
                },
                {
                    "label": "Or share of worldwide annual turnover",
                    "value": 3,
                    "unit": "%"
                }
            ],
            "comparisons": [
                {
                    "title": "What the watermark does vs. doesn't do",
                    "left": {
                        "title": "Does",
                        "points": [
                            "Subtly biases word choices — invisible, detectable in patterns",
                            "Travels with copied text",
                            "Adds signed provenance metadata to files",
                            "Detection API planned for third parties"
                        ]
                    },
                    "right": {
                        "title": "Doesn't",
                        "points": [
                            "Doesn't track individual users",
                            "Doesn't claim ownership of your content",
                            "Can't tell full generation from light editing",
                            "Weaker on short texts and code"
                        ]
                    }
                }
            ],
            "keyPoints": [
                "Watermarking applies worldwide, not only to EU users",
                "Based on Google DeepMind's SynthID Text approach (published in Nature, 2024)",
                "Models released after Aug 2, 2026 watermark by default; older models to follow",
                "SEO experts say rankings are unaffected — Google penalizes spam, not AI use",
                "Anthropic signed the EU Code of Practice on transparency of AI-generated content"
